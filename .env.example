# Copia este fichero como .env y cambia los valores. El .env no se sube nunca al repo.

# --- BBDD (contenedor de PostgreSQL) ---
POSTGRES_USER=paqueteria
POSTGRES_PASSWORD=change-me
POSTGRES_DB=paqueteria

# Conexión que usa Prisma. Debe coincidir con las variables POSTGRES_* de arriba.
# Host: localhost desde tu máquina (make dev, make db-migrate); dentro de Docker,
# el nombre del servicio de la BBDD (por ejemplo, db).
DATABASE_URL="postgresql://paqueteria:change-me@localhost:5432/paqueteria"

# --- Servidor (Express sirve también el frontend) ---
BACKEND_PORT=8000
NODE_ENV=development
